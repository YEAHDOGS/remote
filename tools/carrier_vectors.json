{"_comment":"Shared test vectors for the carrier-frequency compatibility contract. The Python reference in test_carrier.py must agree with IrSender.kt's isCarrierSupported() on every vector.","vectors":[{"expected":true,"freq":38000,"ranges":[],"why":"unknown caps are fail-open"},{"expected":true,"freq":38000,"ranges":[[30000,60000]],"why":"inside single range"},{"expected":true,"freq":30000,"ranges":[[30000,60000]],"why":"lower boundary inclusive"},{"expected":true,"freq":60000,"ranges":[[30000,60000]],"why":"upper boundary inclusive"},{"expected":false,"freq":29999,"ranges":[[30000,60000]],"why":"just below range"},{"expected":false,"freq":60001,"ranges":[[30000,60000]],"why":"just above range"},{"expected":false,"freq":36000,"ranges":[[37000,39000]],"why":"philips 36kHz vs narrow 37-39kHz emitter"},{"expected":true,"freq":37000,"ranges":[[37000,39000]],"why":"panasonic 37kHz on lower boundary"},{"expected":false,"freq":40000,"ranges":[[37000,39000]],"why":"sony 40kHz vs narrow emitter"},{"expected":true,"freq":37917,"ranges":[[37000,39000]],"why":"sharp 37917 inside narrow range"},{"expected":true,"freq":38000,"ranges":[[30000,36000],[37000,39000]],"why":"matches second of multiple ranges"},{"expected":false,"freq":36500,"ranges":[[30000,36000],[37000,39000]],"why":"falls in gap between ranges"}]}